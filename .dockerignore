# Keep the build context lean and keep secrets, docs and artifacts out of the image.
.git
.gitignore
node_modules
.next
dist
test-results
playwright-report

# Never bake these into an image.
.env
.env.*
certs
keys
*.pem
*.key

# Repo docs and agent material are not needed at build time.
docs
AGENTS.md
*.md
.agents

# Compose/proxy config lives on the host, not in the image.
docker-compose.yml
docker-compose.reliability.yml
Caddyfile
Dockerfile
.dockerignore
