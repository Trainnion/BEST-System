# ============================================================================
# BEST-SYSTEM environment template (.env.example)
# Copy to `.env` and fill in. NEVER commit a real .env and never paste real
# values into chat, issues or model prompts (fake data only; Sec. 1 of
# docs/ai-work-distribution.md).
#
# A PERSON GENERATES EVERY SECRET VALUE on the server PC, for example:
#   openssl rand -base64 32
# The field key is created by a person via `npm run keys:generate` and pasted
# into `.env`; it never passes through any model (Sec. 12.3).
# The placeholders below are deliberately NOT working values.
# ============================================================================

# --- Deployment identity -----------------------------------------------------
# production | development. Production refuses demo data and demo credentials
# (Sec. 16.1).
BEST_ENV=CHANGE_ME_production_or_development

# Host name LAN devices use to reach BEST over HTTPS (Sec. 12.2), for example
# best.lan or best.<barangay>.gov.ph. Used by the Caddyfile site address.
BEST_HOST=CHANGE_ME_best.lan

# Kiosk mode flag (Sec. 1.2): disables offline persistence in kiosk mode.
NEXT_PUBLIC_KIOSK=CHANGE_ME_false_or_true

# --- Required secrets (32+ random chars each; generated by a person) ---------
# Database password. No default exists anywhere (Sec. 16.2).
POSTGRES_PASSWORD=CHANGE_ME_32_plus_random_chars_generated_by_a_person

# Session cookie signing/encryption secret (Sec. 12.1 sessions).
SESSION_SECRET=CHANGE_ME_32_plus_random_chars_generated_by_a_person

# HMAC key for blotter proof-of-work challenge nonces (Sec. 15).
QR_HMAC_SECRET=CHANGE_ME_32_plus_random_chars_generated_by_a_person

# Field-level AES-256-GCM key at rest: 32 random bytes, base64 (Sec. 12.1).
# Generate it with `npm run keys:generate`; never commit or log it.
FIELD_ENC_KEY=CHANGE_ME_32_random_bytes_base64_generated_by_a_person

# Optional key id stored with every ciphertext; default fk-1 (Sec. 12.3).
FIELD_ENC_KEY_ID=fk-1

# --- Sessions / AI / demo data ------------------------------------------------
# 15-minute inactivity timeout in milliseconds, enforced on the server (NFR-06).
SESSION_IDLE_MS=900000

# local = nothing leaves the machine (default, works offline) |
# hybrid = optional Gemini enhancement, server-side only, never for blotter or
# any server-encrypted field (OFFLINE-03).
AI_MODE=local

# Only needed when AI_MODE=hybrid. Leave empty for local mode.
GEMINI_API_KEY=

# DEV/TEST ONLY. true seeds demo residents and the Sec. 10.2 demo accounts;
# production refuses to boot with this enabled (Sec. 16.1).
SEED_DEMO_DATA=false

# --- Encryption & reliability --------------------------------------------------
# age recipient PUBLIC key for encrypted backups (Sec. 11.4); the private key
# is kept offline. Required for the reliability overlay (WP-16).
BACKUP_AGE_PUBKEY=

# Warm spare host name or IP for 15-minute rsync sync (Sec. 11.2). Optional.
SPARE_HOST=

# --- Database URLs -------------------------------------------------------------
# Inside the Docker network the app uses the compose-injected DATABASE_URL; set
# this for host-side Prisma commands (Sec. 10.1 STEP 0):
DATABASE_URL=postgresql://best_admin:CHANGE_ME_USE_SAME_POSTGRES_PASSWORD@localhost:5432/best_barangay_db
